{
    "name": "kennersoft/skeleton-pim-demo",
    "description": "Skeleton for KennerPIM with demo data",
    "homepage": "https://kennerpim.de",
    "license": "GPL-3.0-only",
    "minimum-stability": "rc",
    "require": {
        "kennersoft/kennercore": "^3.25.76",
        "kennersoft/multi-languages": "*",
        "kennersoft/pim": "^3.13.0",
        "wizaplace/php-etl": "^1.3",
        "kennersoft/neo4j-pump": "^1.0",
        "kennersoft/sw6-pump": "^1.0",
        "kennersoft/ks-ankermann": "*",
        "kennersoft/advanced-navigation": "*",
        "kennersoft/data-quality": "^1.0"
    },
    "scripts": {
        "pre-update-cmd": "ComposerCmd::preUpdate",
        "post-update-cmd": "ComposerCmd::postUpdate",
        "post-package-install": "ComposerCmd::postPackageInstall",
        "post-package-update": "ComposerCmd::postPackageUpdate",
        "pre-package-uninstall": "ComposerCmd::prePackageUninstall"
    },
    "autoload": {
        "classmap": [
            "composer-cmd.php"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.kennersoft.de/packages.json?id=public"
        },
        {
            "type": "composer",
            "url": "https://packagist.kennersoft.de/packages.json?id=cc64ea64af05212eb6a17"
        }
    ]
}
